            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Risk Distribution"
          },
          "segment_distribution": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Segment Distribution"
          },
          "high_value_high_risk_count": {
