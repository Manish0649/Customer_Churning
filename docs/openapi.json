{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer Churn and Retention API",
    "description": "Predict churn, retrieve K-Means segments and generate rule-based retention recommendations. Optional customer attributes use saved training imputations. Training is offline. Monetary values use the source dataset's currency. Gradio is available at /ui. This local demo has no authentication.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Application running, model not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/model-info": {
      "get": {
        "tags": [
          "Model results"
        ],
        "summary": "Model Info",
        "operationId": "getModelInfo",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            }
          },
          "503": {
            "description": "Model artifact unavailable; export it and restart the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict-churn": {
      "post": {
        "tags": [
          "Model results"
        ],
        "summary": "Predict Churn",
        "operationId": "predictChurn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Customer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "422": {
            "description": "Invalid customer data or batch size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Model artifact unavailable; export it and restart the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/segment-customer": {
      "post": {
