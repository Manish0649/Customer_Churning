    },
    "/customer-strategy/batch": {
      "post": {
        "tags": [
          "Retention"
        ],
        "summary": "Batch Strategy",
        "description": "Score 1\u20131000 customers in input order; include campaign scenario ROI.",
        "operationId": "getBatchStrategies",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
