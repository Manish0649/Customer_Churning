        "examples": [
          {
            "customer_id": "C10291",
            "customer_satisfaction": 4.0,
            "monthlycharges": 89.5,
            "num_complaints": 3,
            "num_service_calls": 5,
            "tenure": 14,
            "totalcharges": 1253.0
          }
